# Firebase Configuration Keys
# In production, populate these from your Firebase Console Project Settings.
# The app includes an automatic fallback demo store if keys are not provided.

NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyYourFirebaseApiKeyHere"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="pawpulse-vetcare.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="pawpulse-vetcare"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="pawpulse-vetcare.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"

